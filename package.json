{
  "name": "way-memory",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:docs",
    "check:docs": "bun run scripts/check-docs.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:persistence": "bun run scripts/persistence-smoke.ts",
    "smoke:closure": "bun run scripts/closure-smoke.ts",
    "smoke:replay": "bun run scripts/replay-smoke.ts",
    "smoke:reconnect": "bun run scripts/reconnect-smoke.ts",
    "smoke:idempotency": "bun run scripts/idempotency-smoke.ts",
    "acceptance:report": "bun run scripts/acceptance-report.ts",
    "android:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/device-acceptance.ps1",
    "replay:session": "bun run scripts/replay-session.ts",
    "dev:api": "bun run services/api/src/index.ts",
    "dev:web": "bun --cwd=apps/web run dev",
    "build:web": "bun --cwd=apps/web run build",
    "typecheck:web": "bun --cwd=apps/web run typecheck"
  }
}
