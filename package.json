{
  "name": "way-memory",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:docs",
    "check:docs": "bun run scripts/check-docs.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:persistence": "bun run scripts/persistence-smoke.ts",
    "smoke:storage": "bun run scripts/storage-smoke.ts",
    "smoke:closure": "bun run scripts/closure-smoke.ts",
    "smoke:replay": "bun run scripts/replay-smoke.ts",
    "smoke:reconnect": "bun run scripts/reconnect-smoke.ts",
    "smoke:idempotency": "bun run scripts/idempotency-smoke.ts",
    "smoke:auth": "bun run scripts/auth-smoke.ts",
    "smoke:lifecycle": "bun run scripts/lifecycle-smoke.ts",
    "smoke:retention": "bun run scripts/retention-smoke.ts",
    "smoke:route": "bun run scripts/route-smoke.ts",
    "smoke:public-live": "bun run scripts/public-live-sample-smoke.ts",
    "smoke:public-route": "bun run scripts/public-route-navigation-smoke.ts",
    "smoke:public-closure": "bun run scripts/public-closure-smoke.ts",
    "smoke:public-auth": "bun run scripts/public-auth-smoke.ts",
    "smoke:release": "bun run scripts/release-runtime-smoke.ts",
    "preflight:public-tls": "bun run scripts/public-tls-preflight.ts",
    "acceptance:report": "bun scripts/acceptance-report.ts",
    "android:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/device-acceptance.ps1",
    "replay:session": "bun scripts/replay-session.ts",
    "dev:api": "bun run services/api/src/index.ts",
    "dev:web": "bun --cwd=apps/web run dev",
    "build:web": "bun --cwd=apps/web run build",
    "typecheck:web": "bun --cwd=apps/web run typecheck",
    "release:build": "bun run scripts/build-release.ts"
  }
}
