<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        A pending queue contains raw sensor/location data and the active
        session marker. The Keystore-backed credential is device-bound and
        must never be migrated to another device. Exclude both from cloud
        backup and device transfer.
    -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="capture-queue" />
        <exclude domain="sharedpref" path="way-memory-credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="capture-queue" />
        <exclude domain="sharedpref" path="way-memory-credentials.xml" />
    </device-transfer>
</data-extraction-rules>
