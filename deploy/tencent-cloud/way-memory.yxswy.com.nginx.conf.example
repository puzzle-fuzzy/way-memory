# Install after DNS and ACME certificates are ready.
# Keep the application bound to 127.0.0.1:8787; expose only Nginx 80/443.

server {
    listen 80;
    listen [::]:80;
    server_name way-memory.yxswy.com;

    location /.well-known/acme-challenge/ {
        root /var/www/way-memory;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name way-memory.yxswy.com;

    root /var/www/way-memory;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/way-memory.yxswy.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/way-memory.yxswy.com/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /realtime {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
